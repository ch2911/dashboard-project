{
  "name": "stock-dashboard",
  "version": "1.0.0",
  "description": "My Stock Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Your Name",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.example.stockdashboard",
    "files": [
      "main.js",
      "node_modules/express/**/*",
      "backend/dist/app",
      "frontend/out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
